<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Swivra</AssemblyName>
    <RootNamespace>Swivra.App</RootNamespace>
    <Version>0.2.1</Version>
    <ApplicationIcon>swivra.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- Also comes in through PDFtoImage; pinned here because ImageIO decodes WebP with it directly. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="swivra.ico" LogicalName="swivra.ico" />
  </ItemGroup>

</Project>
